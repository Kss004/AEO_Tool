# ===== Required =====
# OpenAI — used for GPT-5.5 panel column + query gen + mention extractor
OPENAI_API_KEY=

# Groq — free tier hosts Llama 4 Maverick, Qwen 3 32B, Gemma 2 9B, Kimi K2
# Get key from https://console.groq.com/keys (no credit card required)
GROQ_API_KEY=

# ===== Required for share links =====
# Vercel Blob — get from Vercel dashboard -> Storage -> Create Blob Store
# Auto-populated on Vercel deployments; only set this locally
BLOB_READ_WRITE_TOKEN=

# ===== Rate limiting (recommended for public deploys) =====
# Upstash Redis — backs the per-IP rate limiter on /api/analyze (5 req / hour).
# Provision via Vercel Marketplace -> Storage -> Upstash. Free tier covers a demo.
# When all are unset, the limiter no-ops (good for local dev).
#
# Plain Upstash dashboard injects these:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# Vercel Marketplace integration with prefix "UPSTASH_REDIS_REST" injects these
# instead (no need to set manually — auto-pulled via `vercel env pull`):
# UPSTASH_REDIS_REST_KV_REST_API_URL=
# UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# ===== Optional stretch feature =====
# Tavily Search API — enables "LLM ranking vs real Google top-10" comparison
# Get from https://tavily.com (free tier: 1000 calls/mo)
TAVILY_API_KEY=

# ===== Deprecated (kept for reference, no longer used) =====
# GOOGLE_GENERATIVE_AI_API_KEY=    # was Gemini 2.5 Flash + Gemma 4; replaced by Groq panel
# OPENROUTER_API_KEY=               # was Llama + Qwen via OpenRouter free; replaced by Groq
# AI_GATEWAY_API_KEY=               # not used; project favors direct provider keys
